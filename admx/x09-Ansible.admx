<?xml version="1.0" encoding="utf-8"?>
<!--  (c) 2026 x09  -->
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="x09ansible" namespace="x09.Policies.Ansible" />
    <using prefix="x09base" namespace="x09.Base" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <policies>
    <policy name="AnsiblePlaybook" class="Machine" displayName="$(string.AnsiblePlaybook_Name)"
        explainText="$(string.AnsiblePlaybook_Explain)"
        key="Software\Policies\x09\Ansible"
        presentation="$(presentation.AnsiblePlaybook)">
      <parentCategory ref="x09base:Ansible" />
      <supportedOn ref="x09base:SUPPORTED_x09Ansible" />
      <elements>
        <text id="PlaybookFilename" valueName="PlaybookFilename" maxLength="255" />
      </elements>
    </policy>
  </policies>
</policyDefinitions>
