msgid "Starting libnss-role applier"
msgstr "Запуск обработчика libnss-role"

msgid "No libnss-role policy found in registry"
msgstr "Политика libnss-role не найдена в реестре"

msgid "Using custom role filename: {filename}"
msgstr "Используется пользовательское имя файла ролей: {filename}"

msgid "Read {count} role definitions from policy"
msgstr "Прочитано определений ролей из политики: {count}"

msgid "No roles to write, skipping"
msgstr "Нет ролей для записи, пропускаем"

msgid "Created role directory: {dir}"
msgstr "Создан каталог ролей: {dir}"

msgid "Successfully wrote {count} roles to {file}"
msgstr "Успешно записано ролей: {count} в файл {file}"

msgid "libnss-role applier completed successfully"
msgstr "Обработчик libnss-role завершён успешно"

msgid "Invalid filename '{filename}', using default: {default}"
msgstr "Некорректное имя файла '{filename}', используется по умолчанию: {default}"

msgid "Invalid role line (missing or multiple colons): {line}"
msgstr "Некорректная строка роли (отсутствует двоеточие или их несколько): {line}"

msgid "Invalid role line format: {line}"
msgstr "Некорректный формат строки роли: {line}"

msgid "Invalid role line (empty role name): {line}"
msgstr "Некорректная строка роли (пустое имя роли): {line}"

msgid "Invalid role line (empty group list): {line}"
msgstr "Некорректная строка роли (пустой список групп): {line}"

msgid "Skipping invalid role line: {line}"
msgstr "Пропускается некорректная строка роли: {line}"

msgid "No valid role definitions found after validation"
msgstr "Не найдено корректных определений ролей после проверки"

msgid "Failed to create role directory {dir}: {error}"
msgstr "Не удалось создать каталог ролей {dir}: {error}"

msgid "Failed to write role file {file}: {error}"
msgstr "Не удалось записать файл ролей {file}: {error}"

msgid "libnss-role applier failed: {error}"
msgstr "Обработчик libnss-role завершился с ошибкой: {error}"
