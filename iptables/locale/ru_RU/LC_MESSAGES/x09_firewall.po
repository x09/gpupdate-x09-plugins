msgid "X09 Firewall applier initialized"
msgstr "Плагин X09 Firewall инициализирован"

msgid "Applying firewall rules from registry"
msgstr "Применение правил брандмауэра из реестра"

msgid "Firewall rules applied successfully: {applied} rule(s)"
msgstr "Правила брандмауэра успешно применены: {applied}"

msgid "Firewall rules saved to {path}"
msgstr "Правила брандмауэра сохранены в {path}"

msgid "Skipping plugin: not running in machine context"
msgstr "Плагин пропущен: запуск не в машинном контексте"

msgid "No firewall policy found in registry"
msgstr "Политика брандмауэра не найдена в реестре"

msgid "Skipping invalid rule '{rule}': {reason}"
msgstr "Пропуск некорректного правила '{rule}': {reason}"

msgid "iptables command not available on this system"
msgstr "Команда iptables недоступна в этой системе"

msgid "Failed to apply firewall rules: {error}"
msgstr "Не удалось применить правила брандмауэра: {error}"

msgid "Failed to save firewall rules: {error}"
msgstr "Не удалось сохранить правила брандмауэра: {error}"

msgid "iptables command failed: {command} (exit {code})"
msgstr "Команда iptables завершилась с ошибкой: {command} (код {code})"
